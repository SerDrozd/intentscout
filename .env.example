# Core
RADAR_DB=./data/radar.db
KEYWORDS_CONFIG=./config/keywords.yaml
POLL_INTERVAL_SECONDS=180
LOG_LEVEL=INFO

# Thresholds (override values in keywords.yaml if needed)
ALERT_THRESHOLD=13
REVIEW_THRESHOLD=8
ALERT_REVIEW_QUEUE=false
# Commercial P0 thresholds (Phase 1)
CASH_ALERT_THRESHOLD=72
VALUE_ALERT_THRESHOLD=74
RELATIONSHIP_ALERT_THRESHOLD=76
MAX_ALERTS_PER_CYCLE=5
TELEGRAM_MIN_SEND_INTERVAL_SECONDS=1.15

# Hacker News
HN_ENABLED=true
HN_BOOTSTRAP_ITEMS=300
HN_MAX_ITEMS_PER_CYCLE=500
HN_CONCURRENCY=20

# GitHub public issue search
GITHUB_ENABLED=true
GITHUB_TOKEN=
GITHUB_LOOKBACK_HOURS=24
GITHUB_RESULTS_PER_QUERY=50

# Telegram (optional; console + SQLite work without these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Make Community (public Discourse; no account/API key required)
MAKE_ENABLED=true
MAKE_LOOKBACK_HOURS=48
MAKE_TOPICS_PER_CATEGORY=20

# n8n Community (public Discourse; no account/API key required)
N8N_ENABLED=true
N8N_LOOKBACK_HOURS=48
N8N_TOPICS_PER_CATEGORY=20

# Shared public Discourse fetch concurrency
DISCOURSE_CONCURRENCY=6

# Cheap LLM precision gate (Phase 3)
# Create the key locally at the OpenAI API dashboard; never commit it.
LLM_ENABLED=true
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
DAILY_LLM_BUDGET_USD=0.03
MONTHLY_LLM_BUDGET_USD=0.75
MAX_LLM_CANDIDATES_PER_HOUR=10
MAX_LLM_CANDIDATES_PER_DAY=50
LLM_BATCH_SIZE=5
MAX_POST_CHARS=5000
LLM_MAX_OUTPUT_TOKENS=1200
# Current defaults for gpt-6-luna. Keep configurable because API pricing can change.
LLM_INPUT_PRICE_PER_MTOK=0.10
LLM_CACHED_INPUT_PRICE_PER_MTOK=0.01
LLM_CACHE_WRITE_PRICE_PER_MTOK=0.125
LLM_OUTPUT_PRICE_PER_MTOK=0.50
