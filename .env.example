# Core
RADAR_DB=./data/radar.db
KEYWORDS_CONFIG=./config/keywords.yaml
POLL_INTERVAL_SECONDS=180
LOG_LEVEL=INFO

# Thresholds (override values in keywords.yaml if needed)
ALERT_THRESHOLD=13
REVIEW_THRESHOLD=8
ALERT_REVIEW_QUEUE=false
# Commercial P0 thresholds (Phase 1)
CASH_ALERT_THRESHOLD=72
VALUE_ALERT_THRESHOLD=74
RELATIONSHIP_ALERT_THRESHOLD=76
MAX_ALERTS_PER_CYCLE=5
TELEGRAM_MIN_SEND_INTERVAL_SECONDS=1.15

# Hacker News
HN_ENABLED=false
HN_BOOTSTRAP_ITEMS=300
HN_MAX_ITEMS_PER_CYCLE=500
HN_CONCURRENCY=20

# Targeted HN buyer-intent search via the official Algolia-powered HN Search API.
HN_ALGOLIA_ENABLED=true
HN_ALGOLIA_LOOKBACK_HOURS=48
HN_ALGOLIA_RESULTS_PER_QUERY=50
HN_ALGOLIA_QUERIES_PER_CYCLE=6

# Bluesky public searchPosts; no account/token required for reads.
BLUESKY_ENABLED=true
BLUESKY_LOOKBACK_HOURS=24
BLUESKY_RESULTS_PER_QUERY=25
BLUESKY_QUERIES_PER_CYCLE=6

# Generic RSS/Atom feeds (config-driven; public feeds require no account)
# Per-feed minimum polling intervals live in config/feeds.yaml.
RSS_ENABLED=true
RSS_FEEDS_CONFIG=./config/feeds.yaml
RSS_LOCAL_FEEDS_CONFIG=./config/feeds.local.yaml
GOOGLE_ALERTS_QUERIES_CONFIG=./config/google_alerts_queries.yaml
RSS_CONCURRENCY=4

# GitHub public issue search
GITHUB_ENABLED=true
GITHUB_TOKEN=
GITHUB_LOOKBACK_HOURS=24
GITHUB_RESULTS_PER_QUERY=50

# Telegram (optional; console + SQLite work without these)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Make Community (public Discourse; no account/API key required)
MAKE_ENABLED=true
MAKE_LOOKBACK_HOURS=48
MAKE_TOPICS_PER_CATEGORY=20

# n8n Community (public Discourse; no account/API key required)
N8N_ENABLED=true
N8N_LOOKBACK_HOURS=48
N8N_TOPICS_PER_CATEGORY=20

# HubSpot Community: APIs & Integrations (public HTML fallback; no login required)
HUBSPOT_ENABLED=false
HUBSPOT_LOOKBACK_HOURS=168
HUBSPOT_TOPICS_PER_CATEGORY=20

# Shopify Developer Community: webhooks, auth, orders, inventory (public Discourse)
SHOPIFY_ENABLED=true
SHOPIFY_LOOKBACK_HOURS=48
SHOPIFY_TOPICS_PER_CATEGORY=15

# Bubble Forum: Jobs / Freelance (public Discourse)
BUBBLE_ENABLED=true
BUBBLE_LOOKBACK_HOURS=168
BUBBLE_TOPICS_PER_CATEGORY=30

# Shared public Discourse fetch concurrency
DISCOURSE_CONCURRENCY=6

# Airtable Community Jobs Board (public HTML; low-frequency marketplace)
AIRTABLE_ENABLED=true
AIRTABLE_LOOKBACK_HOURS=336
AIRTABLE_TOPICS_PER_SECTION=20

# Zapier Community: Code & Webhooks / Troubleshooting / How Do I (public HTML)
ZAPIER_ENABLED=true
ZAPIER_LOOKBACK_HOURS=168
ZAPIER_TOPICS_PER_SECTION=15

# Retool Forum: Discussion / Workflows / App Building (public Discourse)
RETOOL_ENABLED=true
RETOOL_LOOKBACK_HOURS=168
RETOOL_TOPICS_PER_CATEGORY=25

# Xano Community: Find a Xano Expert (public marketplace pages)
XANO_ENABLED=true
XANO_LOOKBACK_HOURS=336
XANO_TOPICS_PER_SECTION=30

# FlutterFlow Community: public job postings
FLUTTERFLOW_ENABLED=true
FLUTTERFLOW_LOOKBACK_HOURS=168
FLUTTERFLOW_TOPICS_PER_SECTION=30

# Shared safe public-page fetch concurrency
WEB_FETCH_CONCURRENCY=4

# Safe adaptive scheduling (Phase 8A)
# Uses Phase 7 ROI advice only in memory. It never rewrites config or permanently disables a source/query.
ADAPTIVE_SCHEDULING_ENABLED=true
ADAPTIVE_WINDOW_DAYS=30
ADAPTIVE_REFRESH_CYCLES=10
# Buyer-heavy lanes should never be starved by source-level historical ROI.
PROTECTED_BUYER_SOURCES=n8n,make,airtable,retool,xano,flutterflow
PROTECTED_BUYER_MAX_POLL_CYCLES=1

# Cheap LLM precision gate (Phase 3)
# Create the key locally at the OpenAI API dashboard; never commit it.
LLM_ENABLED=true
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
DAILY_LLM_BUDGET_USD=0.03
MONTHLY_LLM_BUDGET_USD=0.75
MAX_LLM_CANDIDATES_PER_HOUR=12
MAX_LLM_CANDIDATES_PER_DAY=100
# Keep part of the candidate quota protected for fresh Telegram-bound leads.
LLM_ALERT_RESERVE_PER_HOUR=4
LLM_ALERT_RESERVE_PER_DAY=25
# Send a small, fresh P1 review lane after the LLM gate instead of waiting only for perfect P0s.
REVIEW_ALERTS_ENABLED=true
REVIEW_ALERT_MIN_PRIORITY=64
REVIEW_ALERT_MIN_FRESHNESS=68
LLM_BATCH_SIZE=5
MAX_POST_CHARS=5000
LLM_MAX_OUTPUT_TOKENS=1200
# Current defaults for gpt-6-luna. Keep configurable because API pricing can change.
LLM_INPUT_PRICE_PER_MTOK=0.10
LLM_CACHED_INPUT_PRICE_PER_MTOK=0.01
LLM_CACHE_WRITE_PRICE_PER_MTOK=0.125
LLM_OUTPUT_PRICE_PER_MTOK=0.50
